<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ d.run.id }} report</title>
{% include "_style.html.j2" %}
</head>
<body>
<main>
<h1>{{ d.run.id }} <span class="badge s-{{ d.run.status }}">{{ d.run.status }}</span></h1>
<div class="muted">study <b>{{ d.run.study }}</b> · updated {{ d.run.updated_at }}</div>

<div class="wrap"><table>
  <tr>{% for p in d.study_cfg.parameters %}<th class="num">{{ p.name }}{% if p.unit %} [{{ "°" if p.unit == "deg" else p.unit }}]{% endif %}</th>{% endfor %}</tr>
  <tr>{% for p in d.study_cfg.parameters %}<td class="num">{{ d.run.params[p.name]|fmt }}</td>{% endfor %}</tr>
</table></div>

{% if codes %}
<div class="box flag">
  <b>{% if d.run.status in ("FLAGGED", "ACCEPTED", "REJECTED") %}Flagged{% else %}Failed{% endif %}:</b>
  {% for c in codes %}<code>{{ c }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
  {% if failed %}
  <div class="wrap"><table>
    <tr><th>check</th><th class="num">value</th><th class="num">limit</th><th class="num">× limit</th></tr>
    {% for m in failed %}
    <tr><td>{{ m.metric|label }}</td><td class="num">{{ m.value|fmt }}</td><td class="num">{{ m|limit }}</td>
        <td class="num">{% if m.exceedance is not none %}{{ m.exceedance|fmt(3) }}{% else %}—{% endif %}</td></tr>
    {% endfor %}
  </table></div>
  {% endif %}
</div>
{% endif %}

{% if d.reviews %}
<h2>Human review</h2>
<div class="wrap"><table>
  <tr><th>time</th><th>decision</th><th>label</th><th>reviewer</th><th>note</th></tr>
  {% for rv in d.reviews %}
  <tr><td>{{ rv.time }}</td><td>{{ rv.decision }}</td><td><code>{{ rv.label }}</code></td>
      <td>{{ rv.reviewer or "—" }}</td><td>{{ rv.note or "" }}</td></tr>
  {% endfor %}
</table></div>
{% endif %}

<h2>Results</h2>
{% if result_rows %}
<div class="wrap"><table>
  <tr><th>α [°]</th><th class="num">CL</th><th class="num">CL VSPAERO</th><th class="num">CD*</th>
      <th class="num">Cm</th><th class="num">iterations</th><th>converged</th></tr>
  {% for row in result_rows %}
  <tr><td>{{ row.alpha|fmt }}</td><td class="num">{{ row.r.get("CL")|fmt }}</td><td class="num">{{ row.ref.get("CL")|fmt }}</td>
      <td class="num">{{ row.r.get("CD")|fmt }}</td><td class="num">{{ row.r.get("Cm")|fmt }}</td>
      <td class="num">{{ row.r.get("iterations")|fmt }}</td>
      <td>{% if row.r.get("converged") is none %}—{% elif row.r.get("converged") %}yes{% else %}<span class="fail">no</span>{% endif %}</td></tr>
  {% endfor %}
</table></div>
<p class="muted">CL/CD/Cm: mean of the last {{ gates_cfg.gate3.coeff_std_window|fmt }} iterations. *CD is numerical (slip walls). VSPAERO: wing only.</p>
{% else %}
<p class="muted">No results (stopped at {{ d.run.status }}).</p>
{% endif %}
{% if figs.cfd_vs_ref %}<h2>CL vs α</h2><img alt="CL vs alpha" src="data:image/png;base64,{{ figs.cfd_vs_ref }}">{% endif %}
{% if figs.coefficients %}<h2>CL and CD vs iteration</h2><img alt="CL and CD history" src="data:image/png;base64,{{ figs.coefficients }}">{% endif %}

{% if figs.planes %}
<h2>Cutting planes</h2>
<p class="muted">30 % and 70 % semi-span, final iteration of each α. Left: u/U∞ (blue = reversed flow). Right: Cp.</p>
{% for a, img in figs.planes %}<img alt="Cutting planes at alpha {{ a|fmt }}" src="data:image/png;base64,{{ img }}">{% endfor %}
{% endif %}

<details><summary>Gate details, residuals, reference values, corrections</summary>
{% for g in d.gates %}
<h3>{{ g.title }} <span class="muted">(attempt {{ g.latest.attempt }})</span></h3>
{% set checked = g.latest.metrics|selectattr("severity", "equalto", "gate")|list %}
{% set info = g.latest.metrics|rejectattr("severity", "equalto", "gate")|list %}
<div class="wrap"><table>
  <tr><th>check</th><th class="num">value</th><th class="num">limit</th><th>result</th></tr>
  {% for m in checked %}
  <tr><td>{{ m.metric|label }}</td><td class="num">{{ m.value|fmt }}</td><td class="num">{{ m|limit }}</td>
      <td>{% if m.pass %}<span class="pass">pass</span>{% else %}<span class="fail">FAIL</span>{% endif %}</td></tr>
  {% endfor %}
</table></div>
{% if info %}<details><summary>{{ info|length }} info values</summary><div class="wrap"><table>
  {% for m in info %}<tr><td>{{ m.metric|label }}</td><td class="num">{{ m.value|fmt }}</td></tr>{% endfor %}
</table></div></details>{% endif %}
{% if g.earlier %}<details><summary>{{ g.earlier|length }} earlier attempt(s)</summary>
{% for b in g.earlier %}
<div class="muted">attempt {{ b.attempt }}: failed
  {% for m in b.metrics|selectattr("severity", "equalto", "gate")|rejectattr("pass") %}{{ m.metric|label }} = {{ m.value|fmt }} (limit {{ m|limit }}){% if not loop.last %}, {% endif %}{% else %}none{% endfor %}</div>
{% endfor %}</details>{% endif %}
{% endfor %}

<h3>Automatic corrections</h3>
{% if d.corrections %}
<div class="wrap"><table>
  <tr><th>#</th><th>gate</th><th>failure code</th><th>setting</th><th>old</th><th>new</th></tr>
  {% for c in d.corrections %}
  <tr><td>{{ c.attempt }}</td><td>{{ c.gate }}</td><td><code>{{ c.code }}</code></td>
      <td><code>{{ c.param }}</code></td><td>{{ c.old }}</td><td>{{ c.new }}</td></tr>
  {% endfor %}
</table></div>
{% else %}<p class="muted">none</p>{% endif %}

{% if figs.residuals %}<h3>Residuals</h3><img alt="Residual history" src="data:image/png;base64,{{ figs.residuals }}">{% endif %}
{% if d.geometry %}
<h3>Reference values (half model)</h3>
<div class="wrap"><table>
  <tr><th>Sref full [m²]</th><th>Aref half [m²]</th><th>span [m]</th><th>MAC [m]</th><th>x_ref [m]</th><th>tip chord [m]</th></tr>
  <tr><td class="num">{{ d.geometry.sref_full|fmt }}</td><td class="num">{{ d.geometry.sref_half|fmt }}</td>
      <td class="num">{{ d.geometry.span|fmt }}</td><td class="num">{{ d.geometry.mac|fmt }}</td>
      <td class="num">{{ d.geometry.x_ref|fmt }}</td><td class="num">{{ d.geometry.tip_chord|fmt }}</td></tr>
</table></div>
{% endif %}
</details>

<footer>Generated {{ generated }} from <code>{{ db_file }}</code>. All numbers from the run database.</footer>
</main>
</body>
</html>
