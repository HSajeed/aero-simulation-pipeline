{% include "header.j2" %}
application simpleFoam;
startFrom latestTime; startTime 0; stopAt endTime; endTime {{ end_time }};
deltaT 1; writeControl timeStep; writeInterval {{ end_time }}; purgeWrite 0;
writeFormat binary; writePrecision 10; writeCompression off;
timeFormat general; timePrecision 8; runTimeModifiable false;
functions
{
    forceCoeffs1
    {
        type forceCoeffs; libs (forces); writeControl timeStep; writeInterval 1;
        patches (wing fuselage);
        rho rhoInf; rhoInf {{ rho_inf }};
        CofR ({{ cofr|join(' ') }});
        liftDir ({{ lift_dir|join(' ') }}); dragDir ({{ drag_dir|join(' ') }}); pitchAxis (0 1 0);
        magUInf {{ U_inf }}; lRef {{ l_ref }}; Aref {{ a_ref }};   // half-model reference area
    }
    farfieldFlux      // mass balance: net flux through the only open boundary
    {
        type surfaceFieldValue; libs (fieldFunctionObjects); writeControl timeStep; writeInterval 1;
        regionType patch; name farfield; operation sum; fields (phi); writeFields false; log false;
    }
    farfieldFluxMag
    {
        type surfaceFieldValue; libs (fieldFunctionObjects); writeControl timeStep; writeInterval 1;
        regionType patch; name farfield; operation sumMag; fields (phi); writeFields false; log false;
    }
    solverInfo1
    {
        type solverInfo; libs (utilityFunctionObjects); fields (U p); writeResidualFields no;
    }
}
